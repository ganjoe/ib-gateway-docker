###############################################################################
#########   Credentials
###############################################################################
TWS_USERID=danielmeiermobil
TWS_PASSWORD=""
###############################################################################
#########   Trading Mode
#########   paper = Demokonto, live = Echtgeld
###############################################################################
TRADING_MODE=paper
#TRADING_MODE=live

###############################################################################
#########   Timezone
###############################################################################
TIME_ZONE=Europe/Berlin
#TIME_ZONE=America/New_York

###############################################################################
#########   Network Settings
#########   Bind-IP: die IP auf dem Host, unter der das Gateway erreichbar ist
#########   API Port extern: der Port über den du von außen zugreifst
#########   API Port intern: 4004 für paper, 4003 für live (socat-Relay)
#########   Wenn du TRADING_MODE wechselst, passe auch TWS_API_PORT_INT an!
###############################################################################
TWS_BIND_IP=10.20.0.50
TWS_API_PORT_EXT=4002
# Interner Port: 4004 = paper, 4003 = live
TWS_API_PORT_INT=4004
#TWS_API_PORT_INT=4003

###############################################################################
#########   API Settings
###############################################################################
# API kann auch Orders platzieren (nicht nur lesen)
READ_ONLY_API=no
# Eingehende API-Verbindungen automatisch akzeptieren
TWS_ACCEPT_INCOMING=accept
# Sicherheitswarnungen unterdrücken
BYPASS_WARNING=yes
# Blind Trading erlauben
ALLOW_BLIND_TRADING=yes

###############################################################################
#########   2FA & Auto-Restart
###############################################################################
# Bei 2FA-Timeout: neu starten und erneut versuchen
TWOFA_TIMEOUT_ACTION=restart
RELOGIN_AFTER_TWOFA_TIMEOUT=yes
TWOFA_EXIT_INTERVAL=60
TWOFA_DEVICE=

# Täglicher Neustart um 04:00 Uhr (Berliner Zeit)
AUTO_RESTART_TIME=04:00 AM
AUTO_LOGOFF_TIME=

###############################################################################
#########   Session & Einstellungen
###############################################################################
# Docker-Sitzung übernimmt immer, wenn anderswo eingeloggt
EXISTING_SESSION_DETECTED_ACTION=primary
# Einstellungen dauerhaft speichern
TWS_SETTINGS_PATH=/home/ibgateway/Jts

###############################################################################
#########   VNC (grafische Oberfläche des Gateways)
###############################################################################
VNC_SERVER_PASSWORD=asdf

###############################################################################
#########   Java Speicher
###############################################################################
JAVA_HEAP_SIZE=1024

###############################################################################
#########   SSH Tunnel (nicht verwendet)
###############################################################################
SSH_TUNNEL=
SSH_OPTIONS=
SSH_ALIVE_INTERVAL=
SSH_ALIVE_COUNT=
SSH_PASSPHRASE=
SSH_REMOTE_PORT=
SSH_USER_TUNNEL=
SSH_RESTART=
SSH_VNC_PORT=

###############################################################################
#########   Sonstiges
###############################################################################
CUSTOM_CONFIG=
SAVE_TWS_SETTINGS=
TWS_COLD_RESTART=
TWS_MASTER_CLIENT_ID=
#START_SCRIPTS=init-scripts/start_scripts
#X_SCRIPTS=init-scripts/x_scripts
#IBC_SCRIPTS=init-scripts/ibc_scripts
